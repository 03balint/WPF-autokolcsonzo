<Window x:Class="WpfApp4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp4"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="400">
    <Grid>
        <StackPanel Margin="15">
            <TextBlock Text="Autókölcsönző" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"></TextBlock>

            <TextBlock Text="Név:" FontSize="16" Margin="0,30,0,2" FontWeight="Bold"></TextBlock>
            <TextBox x:Name="Name" FontSize="16"></TextBox>

            <TextBlock Text="Életkor:" FontSize="16" Margin="0,15,0,2" FontWeight="Bold"></TextBlock>
            <TextBox x:Name="Age" FontSize="16"></TextBox>

            <TextBlock Text="Jogosítvány száma:" FontSize="16" Margin="0,15,0,2" FontWeight="Bold"></TextBlock>
            <TextBox x:Name="License" FontSize="16"></TextBox>

            <TextBlock Text="Autó kiválasztása:" FontSize="16" Margin="0,15,0,0" FontWeight="Bold"/>
            <ComboBox x:Name="Car" FontSize="16" Margin="0,2,0,0">
                <ComboBoxItem Content="Suzuki Swift - 12 000 Ft / nap" />
                <ComboBoxItem Content="Toyota Corolla – 18 000 Ft / nap" />
                <ComboBoxItem Content="BMW 3 – 30 000 Ft / nap" />
                <ComboBoxItem Content="Tesla Model 3 – 35 000 Ft / nap" />
            </ComboBox>

            <TextBlock Text="Bérlés időtartama (nap):" FontSize="16" Margin="0,15,0,2" FontWeight="Bold"></TextBlock>
            <TextBox x:Name="Day" FontSize="16"></TextBox>

            <TextBlock Text="Biztosítás:" FontSize="16" Margin="0,15,0,0" FontWeight="Bold"/>
            <RadioButton VerticalContentAlignment="Center" x:Name="Ins1" Content="Alap biztosítás – ingyenes" IsChecked="True" FontSize="16" Margin="0,2,0,0" GroupName="biztositas"/>
            <RadioButton VerticalContentAlignment="Center" x:Name="Ins2" Content="Extra biztosítás – +3000 Ft / nap" FontSize="16" Margin="0,5,0,0" GroupName="biztositas"/>
            <RadioButton VerticalContentAlignment="Center" x:Name="Ins3" Content="Teljes biztosítás – +6000 Ft / nap" FontSize="16" Margin="0,5,0,0" GroupName="biztositas"/>

            <TextBlock Text="Extrák:" FontSize="16" Margin="0,15,0,2" FontWeight="Bold"/>
            <CheckBox  VerticalContentAlignment="Center" x:Name="Extra1" Content="GPS – +1000 Ft / nap" FontSize="16" Margin="0,2,0,0"/>
            <CheckBox  VerticalContentAlignment="Center" x:Name="Extra2" Content="Gyerekülés – +1500 Ft / nap" FontSize="16" Margin="0,2,0,0"/>
            <CheckBox  VerticalContentAlignment="Center" x:Name="Extra3" Content="Extra sofőr – +2500 Ft / nap" FontSize="16" Margin="0,2,0,0"/>
            <CheckBox  VerticalContentAlignment="Center" x:Name="Extra4" Content="Autópálya matrica – +5000 Ft egyszeri díj" FontSize="16" Margin="0,2,0,0"/>

            <TextBlock Text="Fizetési mód:" FontSize="16" Margin="0,15,0,0" FontWeight="Bold"/>
            <RadioButton VerticalContentAlignment="Center" x:Name="Pay1" Content="Készpénz" FontSize="16" Margin="0,2,0,0" GroupName="fizetes"/>
            <RadioButton VerticalContentAlignment="Center" x:Name="Pay2" Content="Bankkártya" FontSize="16" Margin="0,5,0,0" GroupName="fizetes"/>

            <CheckBox VerticalContentAlignment="Center" x:Name="Terms" Content="Elfogadom a bérlési feltételeket" FontSize="12" Margin="0,50,0,0"/>

            <Button Height="35" BorderThickness="0" Background="DarkCyan" FontWeight="Bold" x:Name="RendelesLeadasa" Content="Autó foglalása" FontSize="18" Margin="0,20,0,0" Click="Rendeles"/>


        </StackPanel>
    </Grid>
</Window>
